          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \r\n  c.nombre AS [Circuito],\r\n  r.posicion AS [Posición],\r\n  r.id_carro AS [Carro],\r\n  u.nombre_completo AS [Conductor],\r\n  e.nombre AS [Equipo],\r\n  r.tiempo_total AS [Tiempo (s)],\r\n  r.p_usado AS [P],\r\n  r.a_usado AS [A],\r\n  r.m_usado AS [M],\r\n  r.h_conductor AS [H],\r\n  r.velocidad_recta AS [V.Recta],\r\n  r.velocidad_curva AS [V.Curva],\r\n  r.penalizacion AS [Penalización]\r\nFROM RESULTADO r\r\nINNER JOIN SIMULACION s ON s.id_simulacion = r.id_simulacion\r\nINNER JOIN USUARIO u ON u.id_usuario = r.id_conductor\r\nINNER JOIN CARRO ca ON ca.id_carro = r.id_carro\r\nINNER JOIN EQUIPO e ON e.id_equipo = ca.id_equipo\r\nINNER JOIN CIRCUITO c ON c.id_circuito = s.id_circuito\r\nWHERE s.id_simulacion = $id_simulacion\r\nORDER BY r.posicion ASC",
          "refId": "A",
