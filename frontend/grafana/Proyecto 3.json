          "rawQuery": true,
          "rawSql": "SELECT \r\n  r.tiempo_total AS metric,\r\n  r.p_usado AS [Potencia (P)],\r\n  r.a_usado AS [Aerodinamica (A)],\r\n  r.m_usado AS [Manejo (M)],\r\n  CONCAT(u.nombre_completo, ' - Sim ', s.id_simulacion) AS label\r\nFROM RESULTADO r\r\nINNER JOIN SIMULACION s ON s.id_simulacion = r.id_simulacion\r\nINNER JOIN USUARIO u ON u.id_usuario = r.id_conductor\r\nORDER BY r.tiempo_total",
